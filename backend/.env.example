# PostgreSQL connection string for Prisma
# Replace values accordingly and copy to backend/.env
DATABASE_URL="postgresql://smartdesk:smartdesk@localhost:5432/smartdesk?schema=public"

# Password hashing (Scrypt as default implementation)
# Work factors follow Node.js crypto.scrypt options
SCRYPT_N=16384
SCRYPT_r=8
SCRYPT_p=1
SCRYPT_KEYLEN=64

# Password policy (defaults shown). Set true/false as strings.
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# JWT configuration
JWT_ALG=HS256
# Consider using a Base64-encoded 256-bit secret; never commit real secrets
JWT_SECRET="change-me-please-use-secret-manager"
# Optional previous secret for rotation
JWT_SECRET_PREVIOUS=""
# Token TTLs in seconds
ACCESS_TOKEN_TTL=900            # 15 minutes
REFRESH_TOKEN_TTL=2592000       # 30 days
# Token issuer and audience
JWT_ISSUER="smartdesk.api"
JWT_AUDIENCE="smartdesk.pwa"

# Login rate limiting / lockout (example defaults)
LOGIN_MAX_ATTEMPTS=10           # attempts per window before soft lock
LOGIN_WINDOW_MIN=15             # sliding window in minutes
LOGIN_LOCKOUT_MIN=15            # lockout duration after threshold
