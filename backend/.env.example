# PostgreSQL connection string for Prisma
# Replace values accordingly and copy to backend/.env
DATABASE_URL="postgresql://smartdesk:smartdesk@localhost:5432/smartdesk?schema=public"

# Password hashing (Scrypt as default implementation)
# Work factors follow Node.js crypto.scrypt options
SCRYPT_N=16384
SCRYPT_r=8
SCRYPT_p=1
SCRYPT_KEYLEN=64

# Password policy (defaults shown). Set true/false as strings.
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
