// Prisma schema for SmartDesk Coworking - User model
// Datasource and generator
// Note: Ensure DATABASE_URL is provided in environment (e.g., postgres connection string)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Account status for users
enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DISABLED
}

/// User model
/// IMPORTANT: Do not log sensitive fields (passwordHash, salt, verificationToken)
model User {
  id                     String         @id @default(uuid()) @db.Uuid
  email                  String         @unique @db.VarChar(320)
  passwordHash           String         @map("password_hash") @db.VarChar(255)
  salt                   String?        @map("salt") @db.VarChar(255)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  status                 AccountStatus  @default(ACTIVE) @map("status")
  verificationToken      String?        @map("verification_token") @db.VarChar(255)
  verificationExpiresAt  DateTime?      @map("verification_expires_at")

  // relation
  refreshTokens          RefreshToken[]

  @@map("users")
  @@index([createdAt], map: "idx_users_created_at")
  @@index([verificationToken], map: "idx_users_verification_token")
}

/// RefreshToken model for session/refresh management
model RefreshToken {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  tokenHash            String    @map("token_hash") @db.VarChar(255)
  issuedAt             DateTime  @default(now()) @map("issued_at")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  revokedReason        String?   @map("revoked_reason") @db.VarChar(255)
  revokedBy            String?   @map("revoked_by") @db.VarChar(255)
  userAgent            String?   @map("user_agent") @db.VarChar(255)
  ipAddress            String?   @map("ip_address") @db.VarChar(64)
  familyId             String    @map("family_id") @db.Uuid
  replacementTokenId   String?   @map("replacement_token_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user                 User      @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@index([tokenHash], map: "idx_refresh_tokens_token_hash")
  @@index([familyId], map: "idx_refresh_tokens_family_id")
}
